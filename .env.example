# Browser (Vite exposes only VITE_ vars)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only (Vercel project settings) - never prefix these with VITE_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # cron job only
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
CRON_SECRET=a-long-random-string                 # Vercel sends this to the cron route
SERPAPI_KEY=                                      # optional: more reliable live prices

# Cheaper model for tagging and search planning
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Cost tracking: check current prices on the Claude pricing page and adjust (USD)
PRICE_IN_USD_MTOK=3
PRICE_OUT_USD_MTOK=15
PRICE_FAST_IN_USD_MTOK=1
PRICE_FAST_OUT_USD_MTOK=5
PRICE_WEB_SEARCH_USD_1K=10
USD_TO_GBP=0.79
DEFAULT_MONTHLY_CAP_GBP=10

# Optional: email price alerts via Resend (resend.com)
RESEND_API_KEY=
ALERT_FROM=Hem <alerts@your-verified-domain.com>

# How often each wishlist item is re-priced. Default: 68 hours on web search, 20 with SerpAPI.
WISHLIST_CHECK_HOURS=

# Optional: move these features to the cheaper model (comma-separated endpoint names)
# e.g. outfits,precheck,suggest,pairings
FAST_ENDPOINTS=

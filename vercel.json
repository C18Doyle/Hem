{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/prices",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/prices?mode=collect",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/[route].js": {
      "maxDuration": 120
    },
    "api/cron/prices.js": {
      "maxDuration": 300
    }
  }
}